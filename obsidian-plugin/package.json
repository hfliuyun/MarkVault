{
  "name": "obsidian-markvault-publisher",
  "version": "0.2.0",
  "description": "Publish Obsidian notes to MarkVault by calling the markvault CLI.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "tslib": "2.6.3",
    "typescript": "^5.4.5"
  }
}
