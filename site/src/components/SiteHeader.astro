---
import { NAV, SITE, type NavKey } from "../site.config";

interface Props {
  nav: NavKey;
}
const { nav } = Astro.props;
const themes = [
  { pref: "auto", label: "跟随系统", swatch: "background:linear-gradient(90deg,#faf9f5 50%,#1f1e1c 50%)" },
  { pref: "paper", label: "纸 · 暖白", swatch: "background:#faf9f5" },
  { pref: "night", label: "夜 · 暖黑", swatch: "background:#1f1e1c" },
  { pref: "plain", label: "素 · 冷白", swatch: "background:#fff;box-shadow:inset 0 0 0 5px #2f5fd0" },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{SITE.title}</a>
    <nav class="nav" id="site-nav" aria-label="主导航">
      {NAV.map((item) => (
        <a href={item.href} aria-current={item.key === nav ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="tools">
      <a class="icon-btn" href="/search/" title="搜索（⌘K）" aria-current={nav === "search" ? "page" : undefined}>
        搜索 <span class="kbd">⌘K</span>
      </a>
      <a class="icon-btn" href="/paste/" aria-current={nav === "paste" ? "page" : undefined}>Paste</a>
      <div class="theme-menu">
        <button class="icon-btn" id="theme-btn" type="button" title="主题" aria-haspopup="menu" aria-expanded="false">◐</button>
        <div class="theme-pop" id="theme-pop" role="menu" hidden>
          {themes.map((theme) => (
            <button type="button" role="menuitemradio" data-pref={theme.pref} aria-checked="false">
              <span class="swatch" style={theme.swatch}></span>
              {theme.label}
            </button>
          ))}
        </div>
      </div>
      <button class="icon-btn menu-btn" id="menu-btn" type="button" title="菜单" aria-controls="site-nav" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const pop = document.getElementById("theme-pop")!;
  const button = document.getElementById("theme-btn")!;

  function apply(pref: string) {
    try {
      localStorage.setItem("mv-theme", pref);
    } catch {}
    root.dataset.themePref = pref;
    root.dataset.theme = pref === "auto" ? (media.matches ? "night" : "paper") : pref;
    pop.querySelectorAll<HTMLButtonElement>("button").forEach((item) => {
      item.setAttribute("aria-checked", String(item.dataset.pref === pref));
    });
    window.dispatchEvent(new CustomEvent("mv-theme-change", { detail: root.dataset.theme }));
  }

  function setOpen(open: boolean) {
    pop.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
  }

  apply(root.dataset.themePref ?? "auto");
  media.addEventListener("change", () => {
    if (root.dataset.themePref === "auto") apply("auto");
  });
  button.addEventListener("click", (event) => {
    event.stopPropagation();
    setOpen(pop.hidden);
  });
  pop.addEventListener("click", (event) => {
    const item = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-pref]");
    if (!item) return;
    apply(item.dataset.pref!);
    setOpen(false);
  });
  document.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      location.href = "/search/";
    }
  });

  const nav = document.getElementById("site-nav")!;
  const menu = document.getElementById("menu-btn")!;
  menu.addEventListener("click", (event) => {
    event.stopPropagation();
    const open = nav.classList.toggle("open");
    menu.setAttribute("aria-expanded", String(open));
  });
</script>
