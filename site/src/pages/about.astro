---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout title="关于" nav="about">
  <div class="wrap">
    <section class="page-head measure">
      <h1>关于</h1>
      <p>关于这个博客和作者。</p>
    </section>
    <div class="measure prose">
      <p>{SITE.description}</p>
      <p>文章在 Obsidian 里写作，用 MarkVault 构建成静态页面，部署在 Cloudflare。</p>
    </div>
  </div>
</BaseLayout>
