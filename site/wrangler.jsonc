{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "markvault",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // 只有这些路径会执行 Worker 脚本，其余全部是免费的静态资源请求。
    "run_worker_first": ["/img/*", "/api/*", "/paste/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "markvault",
      "database_id": "003333e1-03a1-4990-a3ef-08e6d6c87ee8",
      "migrations_dir": "./worker/migrations"
    }
  ],
  "vars": {
    // CLOUDINARY_CLOUD 不写在这里（代码仓库是公开的），由 markvault deploy 用 --var 传入。
    // 允许自己的其他子域名引用图片（例如经 EdgeOne 加速的测试域名）。
    "IMG_REFERER_ALLOW": "liuyun.ac.cn"
  },
  // 每小时清理过期的 paste 和配对码。
  "triggers": { "crons": ["0 * * * *"] },
  // 只用正式域名，不开 workers.dev，免得同一份内容有两个地址。
  "routes": [{ "pattern": "blog.liuyun.ac.cn", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
